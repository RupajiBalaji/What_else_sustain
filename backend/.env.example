# Gemini API Key for Ask What Else AI Advisor (optional for offline fallback)
# Supports a single key or comma-separated list of keys for rotational load-balancing
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_API_KEYS=YOUR_GEMINI_KEY_1,YOUR_GEMINI_KEY_2

# Allowed CORS origins (comma-separated or JSON list)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server Port (default 8000)
PORT=8000

# Database URL for storing anonymous gameplay sessions (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite:///./local.db
